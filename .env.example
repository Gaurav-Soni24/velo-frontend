# Velo admin dashboard environment. Copy to .env and fill in. Never commit .env.
# Everything prefixed NEXT_PUBLIC_ is visible in the browser: never put passwords or keys here.
# The admin login itself is configured in the backend .env (ADMIN_EMAIL, ADMIN_PASSWORD_HASH, JWT_SECRET).

# URL of the Velo backend API (https://github.com/Gaurav-Soni24/velo-backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Public URL of this dashboard (used for link previews).
NEXT_PUBLIC_SITE_URL=https://velo-frontend.vercel.app
